<Window x:Class="LoRaConfig.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LoRaConfig - LG206" Height="720" Width="1000" MinHeight="600" MinWidth="820" WindowStartupLocation="CenterScreen">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="LoRaConfig" FontSize="28" FontWeight="Bold"/><TextBlock Text="LG206 module setup — read, apply, save and verify" Foreground="Gray"/></StackPanel>
<Border Grid.Row="1" BorderBrush="#D5D9E0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,10,10"><TextBlock Text="COM port"/><ComboBox x:Name="PortCombo" Height="30" IsEditable="True"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,10,10"><TextBlock Text="Production line"/><ComboBox x:Name="LineCombo" Height="30" SelectedIndex="0"><ComboBoxItem Content="Line 9"/><ComboBoxItem Content="Line 10"/><ComboBoxItem Content="Line 11"/></ComboBox></StackPanel>
<StackPanel Grid.Column="2" Margin="0,0,10,10"><TextBlock Text="Module role"/><ComboBox x:Name="RoleCombo" Height="30" SelectedIndex="0"><ComboBoxItem Content="Line receiver / gateway"/><ComboBoxItem Content="Pump transmitter"/></ComboBox></StackPanel>
<StackPanel Grid.Column="3" Margin="0,0,0,10"><TextBlock Text="Channel"/><ComboBox x:Name="ChannelCombo" Height="30" SelectedIndex="1"><ComboBoxItem Content="CH65"/><ComboBoxItem Content="CH66"/></ComboBox></StackPanel>
<StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,0,0,10">
    <Button x:Name="RefreshButton" Content="Refresh Ports" Padding="12,7" Margin="0,0,8,0" Click="RefreshButton_Click"/>
    <Button x:Name="ReadButton" Content="Read Configuration" Padding="12,7" Margin="0,0,8,0" Click="ReadButton_Click"/>
    <Button x:Name="ApplyButton" Content="Apply, Save &amp; Verify" Padding="12,7" Click="ApplyButton_Click" FontWeight="Bold"/>
</StackPanel>
<TextBlock Grid.Row="2" Grid.ColumnSpan="4" TextWrapping="Wrap" Foreground="#8A4B08" Text="Only connect the intended replacement/test module. Confirm the channel is approved and unused. NID is read and preserved; this utility does not change NID or factory-reset modules."/></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
<GroupBox Header="Target profile" Grid.Column="0" Margin="0,0,10,0" Padding="10"><StackPanel><TextBlock Text="WMODE: TRANS"/><TextBlock Text="UART: 115200,8,1,NONE,NFC" Margin="0,7,0,0"/><TextBlock Text="SPD: 8" Margin="0,7,0,0"/><TextBlock Text="ADDR: 888" Margin="0,7,0,0"/><TextBlock Text="FEC: OFF" Margin="0,7,0,0"/><TextBlock Text="PWR: 20" Margin="0,7,0,0"/><TextBlock Text="RSNUM: 0" Margin="0,7,0,0"/><TextBlock Text="PMODE: RUN" Margin="0,7,0,0"/><TextBlock Text="CH: selected above" Margin="0,7,0,0"/><Separator Margin="0,14,0,10"/><TextBlock Text="NID is preserved and logged. Line and role are recorded in the log; current profile settings are the same for both roles." TextWrapping="Wrap" Foreground="Gray"/></StackPanel></GroupBox>
<GroupBox Header="Operation log / verification" Grid.Column="1" Padding="8"><TextBox x:Name="LogBox" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#101820" Foreground="#D7E5F0"/></GroupBox></Grid>
<DockPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="Gray"/><Button Content="Open Log Folder" DockPanel.Dock="Right" Padding="12,7" Click="OpenLogFolder_Click"/></DockPanel></Grid></Window>