<Window x:Class="VacuumPumpSystem.Views.ReceiverSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Receiver"
        Width="420"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="SELECT COMMUNICATION RECEIVER"
                       FontSize="20"
                       FontWeight="Bold"/>

            <TextBlock Text="Multiple serial receivers were detected. Select the receiver for this production line."
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,8,0,15"/>

        </StackPanel>

        <ListBox x:Name="PortsList"
                 Grid.Row="1"
                 SelectionMode="Single"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="CANCEL"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="CONNECT"
                    Width="100"
                    Height="32"
                    Click="Connect_Click"/>

        </StackPanel>

    </Grid>

</Window>