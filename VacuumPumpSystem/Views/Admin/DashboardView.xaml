<UserControl x:Class="VacuumPumpSystem.Views.Admin.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <StackPanel>

            <TextBlock Text="DASHBOARD"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Vacuum Pump System Overview"
                       FontSize="16"
                       Margin="0,5,0,30"/>

            <UniformGrid Columns="4">

                <Border BorderBrush="Gray"
                        BorderThickness="1"
                        Padding="20"
                        Margin="5">

                    <StackPanel>
                        <TextBlock Text="TOTAL MACHINES"
                                   FontWeight="Bold"/>
                        <TextBlock Text="28"
                                   FontSize="28"/>
                    </StackPanel>

                </Border>

                <Border BorderBrush="Gray"
                        BorderThickness="1"
                        Padding="20"
                        Margin="5">

                    <StackPanel>
                        <TextBlock Text="ONLINE"
                                   FontWeight="Bold"/>
                        <TextBlock Text="0"
                                   FontSize="28"/>
                    </StackPanel>

                </Border>

                <Border BorderBrush="Gray"
                        BorderThickness="1"
                        Padding="20"
                        Margin="5">

                    <StackPanel>
                        <TextBlock Text="OFFLINE"
                                   FontWeight="Bold"/>
                        <TextBlock Text="0"
                                   FontSize="28"/>
                    </StackPanel>

                </Border>

                <Border BorderBrush="Gray"
                        BorderThickness="1"
                        Padding="20"
                        Margin="5">

                    <StackPanel>
                        <TextBlock Text="UNREGISTERED"
                                   FontWeight="Bold"/>
                        <TextBlock Text="0"
                                   FontSize="28"/>
                    </StackPanel>

                </Border>

            </UniformGrid>

        </StackPanel>

    </Grid>

</UserControl>