<Window x:Class="VacuumPumpSystem.Views.Admin.AddLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Production Line"
        Width="450"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add Production Line"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,15">

            <TextBlock Text="Line Code"/>

            <TextBox x:Name="LineCodeTextBox"
                     Margin="0,5,0,0"
                     Height="32"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,15">

            <TextBlock Text="Line Name"/>

            <TextBox x:Name="LineNameTextBox"
                     Margin="0,5,0,0"
                     Height="32"/>

        </StackPanel>

        <StackPanel Grid.Row="3">

            <TextBlock Text="Description"/>

            <TextBox x:Name="DescriptionTextBox"
                     Margin="0,5,0,0"
                     Height="70"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>

        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="CANCEL"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="SAVE"
                    Width="90"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>