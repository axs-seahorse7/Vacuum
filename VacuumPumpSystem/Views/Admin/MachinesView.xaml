<UserControl x:Class="VacuumPumpSystem.Views.Admin.MachinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Machines"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Registered vacuum pump machines"
                           FontSize="14"
                           Foreground="Gray"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="REFRESH"
                    Width="100"
                    Height="32"
                    Click="Refresh_Click"/>

        </Grid>


        <!-- SUMMARY -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="20"
                    Margin="0,0,8,0">

                <StackPanel>

                    <TextBlock Text="TOTAL MACHINES"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="TotalMachinesText"
                               Text="0"
                               FontSize="28"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <Border Grid.Column="1"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="20"
                    Margin="4,0">

                <StackPanel>

                    <TextBlock Text="ONLINE"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="OnlineMachinesText"
                               Text="0"
                               FontSize="28"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <Border Grid.Column="2"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="20"
                    Margin="8,0,0,0">

                <StackPanel>

                    <TextBlock Text="OFFLINE"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="OfflineMachinesText"
                               Text="0"
                               FontSize="28"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- MACHINE TABLE -->

        <DataGrid x:Name="MachinesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Dummy Code"
                                    Binding="{Binding DummyCode}"
                                    Width="120"/>

                <DataGridTextColumn Header="Modbus"
                                    Binding="{Binding ModbusAddress}"
                                    Width="90"/>

                <DataGridTextColumn Header="Machine Name"
                                    Binding="{Binding MachineName}"
                                    Width="200"/>

                <DataGridTextColumn Header="Pressure (mbar)"
                                    Binding="{Binding CurrentPressure, StringFormat={}{0:F3}}"
                                    Width="140"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding IsOnline}"
                                    Width="100"/>

                <DataGridTextColumn Header="Last Seen"
                                    Binding="{Binding LastSeen}"
                                    Width="180"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>