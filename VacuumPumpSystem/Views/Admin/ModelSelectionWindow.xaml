
<Window x:Class="VacuumPumpSystem.Views.ModelSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Product Model"
        Width="480"
        Height="420"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select Product Model"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#111827"/>

        <TextBlock Grid.Row="1"
                   Text="Choose the model before scanning product serial numbers."
                   TextWrapping="Wrap"
                   Foreground="#64748B"
                   Margin="0,6,0,16"/>

        <ListBox x:Name="ModelsListBox"
                 Grid.Row="2"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1"
                 Background="White"
                 FontSize="15"
                 Padding="6"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,12"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding ModelName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>
                            <TextBlock Text="{Binding SerialPrefix,
                                              StringFormat=Serial prefix: {0}}"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel"
                    Width="95"
                    Height="38"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>

            <Button Content="Save"
                    Width="100"
                    Height="38"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
