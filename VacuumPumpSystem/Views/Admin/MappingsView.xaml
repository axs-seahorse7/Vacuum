
<UserControl x:Class="VacuumPumpSystem.Views.Admin.MappingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Product Mapping"
                           FontSize="28"
                           FontWeight="Bold"/>
                <TextBlock Text="Scan a machine Dummy code and associate a product serial number."
                           Margin="0,8,0,0"
                           Foreground="Gray"
                           FontSize="14"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="22"
                    Background="#F5F7FA"
                    CornerRadius="10"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="1. Scan Machine Dummy Code"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="DummyCodeTextBox"
                             Height="42"
                             FontSize="16"
                             Padding="10"
                             VerticalContentAlignment="Center"
                             ToolTip="Scan Dummy code, e.g. DM1"/>

                    <TextBlock x:Name="MachineInfoText"
                               Margin="0,10,0,0"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="Gray"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Padding="22"
                    Background="#F5F7FA"
                    CornerRadius="10"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="2. Scan Product Serial Number"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="ProductCodeTextBox"
                             Height="42"
                             FontSize="16"
                             Padding="10"
                             VerticalContentAlignment="Center"
                             ToolTip="Scan product barcode or QR code"/>

                    <Button x:Name="MapButton"
                            Content="Map Product"
                            Height="44"
                            Margin="0,15,0,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Click="MapButton_Click"/>

                    <TextBlock x:Name="StatusText"
                               Margin="0,12,0,0"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Padding="22"
                    Background="White"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Current Active Mapping"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="CurrentMappingText"
                               Text="Scan a Dummy code to check its active mapping."
                               Margin="0,12,0,0"
                               FontSize="15"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
