<UserControl x:Class="VacuumPumpSystem.Views.Admin.DeviceDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Device Discovery"
                    FontSize="28"
                    FontWeight="Bold"/>

            <TextBlock x:Name="LineContextText"
                    Text="Live Modbus devices detected from the selected production line"
                    FontSize="14"
                    Foreground="Gray"
                    Margin="0,5,0,0"/>

        </StackPanel>


        <!-- DEVICE TABLE -->

        <DataGrid x:Name="DevicesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Modbus"
                                    Binding="{Binding ModbusAddress}"
                                    Width="80"/>

                <DataGridTextColumn Header="Dummy Code"
                                    Binding="{Binding DummyCode}"
                                    Width="110"/>

                <DataGridTextColumn Header="Machine Name"
                                    Binding="{Binding MachineName}"
                                    Width="180"/>

                <DataGridTextColumn Header="Pressure (mbar)"
                                    Binding="{Binding Pressure, StringFormat={}{0:F3}}"
                                    Width="130"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="100"/>

                <DataGridTextColumn Header="Last Seen"
                                    Binding="{Binding LastSeen}"
                                    Width="180"/>

                <DataGridTextColumn Header="Registered"
                                    Binding="{Binding IsRegistered}"
                                    Width="100"/>

                <DataGridTemplateColumn Header="Action"
                                        Width="120">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Button Content="REGISTER"
                                Click="Register_Click"
                                Padding="10,5"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>