<Window x:Class="VacuumPumpSystem.Views.RegisterMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register Machine"
        Width="450"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="REGISTER MACHINE"
                   FontSize="22"
                   FontWeight="Bold"/>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Modbus Address:"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="ModbusAddressTextBox"
                     Grid.Column="1"
                     IsReadOnly="True"
                     Height="30"/>

        </Grid>

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Machine Name:"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="MachineNameTextBox"
                     Grid.Column="1"
                     Height="30"/>

        </Grid>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="CANCEL"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="SAVE"
                    Width="90"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>